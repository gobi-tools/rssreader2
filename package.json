{
  "name": "simple-libs",
  "version": "0.0.1",
  "description": "A small, assemble-it-yourself web framework: Hono + Drizzle/SQLite + better-auth + react-srv SSR",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "res": "cp -r res/ public/",
    "bundle": "rm -rf public && react-srv bundle -f src/frontend/react-srv.config.ts",
    "build": "tsc && npm run bundle && npm run res",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config src/db/drizzle.config.ts",
    "db:migrate": "mkdir -p data && drizzle-kit migrate --config src/db/drizzle.config.ts",
    "db:migrate:runtime": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push --config src/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config src/db/drizzle.config.ts",
    "auth:generate": "auth generate --config src/auth.ts --output src/db/schema.ts -y",
    "auth:secret": "auth secret"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "better-auth": "^1.7.12",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "feedsmith": "^3.0.1",
    "hono": "^4.11.9",
    "preact": "^11.0.2",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.1",
    "react-srv": "^0.0.82"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "auth": "^1.7.12",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
